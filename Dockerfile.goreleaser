FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
# GoReleaser (dockers_v2) puts each platform's binary under linux/<arch>/.
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/xmpp-releasetracker .
VOLUME ["/data"]
ENTRYPOINT ["/app/xmpp-releasetracker"]
CMD ["-config", "/etc/xmpp-releasetracker/config.yml"]
